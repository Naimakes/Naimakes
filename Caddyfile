{$DOMAIN} {
  encode zstd gzip
  @assistant path /api/assistant/chat
  handle @assistant {
    request_body {
      max_size 512MB
    }
    reverse_proxy forum:3001
  }
  handle {
    request_body {
      max_size 30MB
    }
    reverse_proxy forum:3001
  }
}

www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}
