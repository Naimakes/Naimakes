APP_ORIGIN=https://forum.your-domain.com
COOKIE_SECURE=true
ADMIN_EMAIL=Naimakes@outlook.com
SEED_DEMO=false
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DOMAIN=forum.your-domain.com
# AI 助手接哪一家（按顺序取第一个填了的）：DeepSeek、任意 OpenAI 兼容接口、Claude
DEEPSEEK_API_KEY=
# DeepSeek 默认走原生的 OpenAI 兼容接口；填 anthropic 改走它的 Anthropic 兼容接口
ASSISTANT_API=
# OpenAI 兼容接口（OpenAI、通义千问、Kimi、智谱、本地 vLLM/Ollama 等），需要同时填 ASSISTANT_MODEL
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=deepseek-flash
# 生成对话标题的轻量模型，留空则 DeepSeek 下用 deepseek-flash、Claude 下用 claude-haiku-5-5
ASSISTANT_TITLE_MODEL=
ASSISTANT_EFFORT=low
# 模型不支持 reasoning_effort 参数时填 off
OPENAI_REASONING=
ASSISTANT_RATE_LIMIT=12
ASSISTANT_DAILY_LIMIT=300
# 联网搜索（可选）：bocha（博查，国内推荐）/ tavily / brave / searxng，留空则不开启
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=
# SearXNG 填实例地址；其他服务商一般留空（填了会替换默认接口地址）
WEB_SEARCH_URL=
