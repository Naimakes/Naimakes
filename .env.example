APP_ORIGIN=https://forum.your-domain.com
COOKIE_SECURE=true
ADMIN_EMAIL=Naimakes@outlook.com
SEED_DEMO=false
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DOMAIN=forum.your-domain.com
ANTHROPIC_API_KEY=
# 使用 Claude 时留空；改用 DeepSeek 时填 https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
# DeepSeek V4.1 Flash 的模型名是 deepseek-flash
ASSISTANT_MODEL=claude-opus-5-5
# 用于生成对话标题的轻量模型，DeepSeek 下同样填 deepseek-flash
ASSISTANT_TITLE_MODEL=claude-haiku-5-5
# DeepSeek 支持 low / high / max
ASSISTANT_EFFORT=low
ASSISTANT_RATE_LIMIT=12
ASSISTANT_DAILY_LIMIT=300
